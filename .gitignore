# ============================================================
#  个人数据与运行期状态一律不进 git。
#  (忽略 != 删除: 这些文件仍留在你的磁盘上, 程序照常使用)
# ============================================================

# ---- 登录凭据(绝不外传) ----
/tools/BBDown.data
/tools/BBDown.data.bak
/tools/qrcode.png
/tools/qrcode_key.txt

# ---- 下载内容与运行状态 ----
/videos/*
!/videos/.gitkeep
/logs/

# ---- 个人配置(每个使用者自己留一份) ----
/tools/下载设置.txt
/tools/python_paths.txt

# ---- 运行期小文件: 锁 / 谁在跑 / 停止请求 ----
/tools/*.lock
/tools/*-谁在跑.txt
/tools/守护-停止请求.txt
/tools/优雅停止请求.txt

# ---- 教程视频不进仓库(体积大, 来源需自行确认) ----
/使用方法/*.mp4
/使用方法/*.srt

# ---- 环境与生成物 ----
/.vscode/
__pycache__/
*.py[cod]
Thumbs.db
desktop.ini
